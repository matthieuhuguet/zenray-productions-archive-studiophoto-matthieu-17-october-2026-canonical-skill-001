# Split a grid of portraits (an AI sheet of 2 x 2, say) into one PNG per cell, cutting on the MEASURED white separators. 23 October 2026
# FR : découpe une planche de portraits sur ses séparateurs blancs mesurés (jamais devinés), un PNG par case.
# Usage: python3 SplitGrid.py <grid.png> <out-dir> [--rows 2] [--cols 2] [--white 240] [--margin 1]
# A separator is a run of rows (or columns) in which at least --frac (0.25) of the pixels are brighter than --white; the margin is trimmed only on the sides that touch a separator,
# never on the outer border. Measured on matthieu10.png: columns 625 to 628, rows 623 to 627, cells 624 x 622. Cells are named <stem>-r<row>c<col>.png.
import argparse, os
import numpy as np
from PIL import Image

ap = argparse.ArgumentParser(); ap.add_argument("grid"); ap.add_argument("out"); ap.add_argument("--rows", type=int, default=2); ap.add_argument("--cols", type=int, default=2)
ap.add_argument("--white", type=int, default=240); ap.add_argument("--margin", type=int, default=1); ap.add_argument("--frac", type=float, default=0.25)
ar = ap.parse_args()
a = np.asarray(Image.open(ar.grid).convert("L"))
H, W = a.shape

def bands(frac_white):
    """Runs of True in a boolean line profile -> list of (start, end) inclusive."""
    runs, start = [], None
    for i, v in enumerate(frac_white):
        if v and start is None: start = i
        if not v and start is not None: runs.append((start, i - 1)); start = None
    if start is not None: runs.append((start, len(frac_white) - 1))
    return runs

def cuts(profile, n, size):
    """The n-1 interior separators: runs that do not touch the border, widest first, then in order."""
    inner = [r for r in bands(profile >= ar.frac) if r[0] > 0 and r[1] < size - 1]
    inner = sorted(sorted(inner, key=lambda r: r[0] - r[1])[: n - 1])
    if len(inner) != n - 1: raise SystemExit(f"found {len(inner)} separators, expected {n - 1}: lower --white or check the grid")
    edges, prev = [], 0
    for s, e in inner: edges.append((prev, s)); prev = e + 1
    edges.append((prev, size)); return edges

rowprof = (a > ar.white).mean(axis=1); colprof = (a > ar.white).mean(axis=0)
rows, cols = cuts(rowprof, ar.rows, H), cuts(colprof, ar.cols, W)
os.makedirs(ar.out, exist_ok=True); stem = os.path.splitext(os.path.basename(ar.grid))[0]; img = Image.open(ar.grid).convert("RGB")
for r, (y0, y1) in enumerate(rows):
    for c, (x0, x1) in enumerate(cols):
        box = (x0 + (ar.margin if c > 0 else 0), y0 + (ar.margin if r > 0 else 0), x1 - (ar.margin if c < ar.cols - 1 else 0), y1 - (ar.margin if r < ar.rows - 1 else 0)); p = f"{ar.out}/{stem}-r{r + 1}c{c + 1}.png"
        img.crop(box).save(p); print(p, box, f"{box[2] - box[0]}x{box[3] - box[1]}")
